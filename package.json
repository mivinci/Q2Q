{
  "name": "q2q",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Q2Q：开源 P2P 网络框架，发布者无需自建后端",
  "workspaces": [
    "crates/q2q-wasm",
    "apps/*",
    "docs",
    "packages/*"
  ],
  "scripts": {
    "wasm:build": "npm run build --workspace @q2q/wasm",
    "wasm:check": "npm run check --workspace @q2q/wasm --",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "e2e": "node e2e/check-site.mjs",
    "test": "npm run docs:build && npm run e2e",
    "platform:dev": "npm run dev --workspace @q2q/platform",
    "platform:dev:workers": "npm run dev:workers --workspace @q2q/platform",
    "platform:check:processing": "npm run check:processing --workspace @q2q/platform",
    "platform:check:storage": "npm run check:storage --workspace @q2q/platform",
    "platform:check:projects": "npm run check:projects --workspace @q2q/platform",
    "platform:check:projects:http": "npm run check:projects:http --workspace @q2q/platform",
    "platform:check": "npm run check --workspace @q2q/platform",
    "platform:build": "npm run build --workspace @q2q/platform",
    "seed-processing:check": "npm run check --workspace @q2q/seed-processing",
    "seed-processing:build": "npm run build --workspace @q2q/seed-processing",
    "platform:preview": "npm run preview --workspace @q2q/platform",
    "platform:types": "npm run types --workspace @q2q/platform",
    "platform:db:migrate": "npm run db:migrate --workspace @q2q/platform",
    "admin:dev": "npm run dev --workspace @q2q/admin",
    "admin:check": "npm run check --workspace @q2q/admin",
    "admin:build": "npm run build --workspace @q2q/admin",
    "admin:test": "npm test --workspace @q2q/admin",
    "platform:check:accounts": "npm run check:accounts --workspace @q2q/platform"
  },
  "devDependencies": {
    "playwright-core": "^1.57.0"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
