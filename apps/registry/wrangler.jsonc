{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "q2q-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "q2q-registry",
      // Replace with the ID from `wrangler d1 create q2q-registry` before deployment.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
