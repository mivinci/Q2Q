{
  "name": "@q2q/registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run types && tsc --project tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "types": "wrangler types",
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "jose": "^6.0.0",
    "zod": "^4.6.7",
    "@q2q/punch-discovery": "*",
    "@q2q/punch-management": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.2",
    "esbuild": "0.21.5",
    "miniflare": "5.20261019.0-beta"
  }
}
