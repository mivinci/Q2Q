{
  "name": "@q2q/www",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5188 --strictPort",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run wasm:build --prefix ../.. && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "cargo build --manifest-path ../../Cargo.toml -p q2q-punch-server && playwright test"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@q2q/client-web": "*",
    "@q2q/ui": "*",
    "mode-watcher": "^1.1.0",
    "bits-ui": "^2.19.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.19.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.97.0",
    "@lucide/svelte": "^1.59.0",
    "@playwright/test": "1.57.0"
  }
}
