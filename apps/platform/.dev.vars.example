# Copy to .dev.vars and fill locally. Use the actual public origin in production.
AUTH_ORIGIN=http://localhost:5173
PLATFORM_TRACK_URL=
REGISTRY_URL=
REGISTRY_NODES_TOKEN=
# Set to "enabled" only when developing the local plans UI. Never set this in production.
# BILLING_SIMULATION=enabled
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: configure both values to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vite dev only; never used by the production Worker. Local uploads are limited to 64 MiB.
UPLOAD_LOCAL_PROXY=true
# S3-compatible storage. Use region=auto for R2; use your provider's actual region otherwise.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true: endpoint/bucket/key; false: bucket.endpoint/key
S3_FORCE_PATH_STYLE=true
