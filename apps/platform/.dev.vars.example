# Copy to .dev.vars and fill locally. Use the actual public origin in production.
AUTH_ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Vite dev only; never used by the production Worker. Local uploads are limited to 64 MiB.
UPLOAD_LOCAL_PROXY=true
# S3-compatible storage. Use region=auto for R2; use your provider's actual region otherwise.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true: endpoint/bucket/key; false: bucket.endpoint/key
S3_FORCE_PATH_STYLE=true
