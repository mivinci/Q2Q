{
  "name": "@q2q/platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:workers": "wrangler dev -c wrangler.jsonc -c wrangler.processing.jsonc --ip localhost --port 5173 --log-level warn",
    "build": "npm run wasm:build --prefix ../.. && npm run types && vite build && wrangler deploy --dry-run -c wrangler.processing.jsonc --outdir .wrangler/processing-build",
    "preview": "wrangler dev -c wrangler.jsonc -c wrangler.processing.jsonc --port 4173 --log-level warn",
    "check:processing": "node --experimental-strip-types scripts/check-processing.mjs",
    "prepare": "svelte-kit sync",
    "check": "npm run wasm:build --prefix ../.. && npm run types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "npm run types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply DB --local"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.59.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.19.2",
    "bits-ui": "^2.19.5",
    "cn": "^0.5.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.97.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@q2q/wasm": "*",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.10",
    "fast-xml-parser": "^5.11.2",
    "mode-watcher": "^1.1.0"
  }
}
