{
  "name": "@q2q/platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:workers": "wrangler dev -c wrangler.jsonc -c ../seed-processing/wrangler.jsonc --persist-to .wrangler/state --ip localhost --port 5173 --log-level warn",
    "build": "npm run wasm:build --prefix ../.. && npm run types && vite build",
    "preview": "wrangler dev -c wrangler.jsonc -c ../seed-processing/wrangler.jsonc --persist-to .wrangler/state --port 4173 --log-level warn",
    "check:processing": "node --experimental-strip-types scripts/check-processing.mjs",
    "check:billing": "node --experimental-strip-types --test scripts/check-billing.mjs",
    "check:storage": "node --experimental-strip-types scripts/check-storage-quota.mjs",
    "check:projects": "node --experimental-strip-types scripts/check-project-invitations.mjs",
    "check:projects:http": "node --experimental-strip-types scripts/check-project-invitations-http.mjs",
    "prepare": "svelte-kit sync",
    "check": "npm run wasm:build --prefix ../.. && npm run types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "npm run types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "check:nodes": "node --experimental-strip-types scripts/check-registry-nodes.mjs",
    "check:accounts": "node --experimental-strip-types scripts/check-account-access.mjs"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.19.2",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.97.0",
    "@q2q/punch-discovery": "*",
    "@lucide/svelte": "^1.59.0",
    "bits-ui": "^2.19.5"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@q2q/wasm": "*",
    "@q2q/s3-storage": "*",
    "@q2q/seed-processing-contract": "*",
    "better-auth": "^1.7.10",
    "mode-watcher": "^1.1.0",
    "@q2q/ui": "*",
    "@q2q/plans": "*",
    "@q2q/accounts": "*"
  }
}
