{
  "name": "@q2q/admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prepare": "svelte-kit sync",
    "types": "wrangler types",
    "check": "npm run types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run types && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@q2q/ui": "*",
    "@q2q/plans": "*",
    "mode-watcher": "^1.1.0",
    "jose": "^6.1.0",
    "@q2q/accounts": "*",
    "@q2q/punch-management": "*"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.19.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.97.0",
    "@lucide/svelte": "^1.59.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
